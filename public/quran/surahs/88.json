{"number":88,"name":"Al-Ghaashiya","arabicName":"الغاشية","englishTranslation":"The Overwhelming","numberOfAyahs":26,"revelationType":"Meccan","order":68,"rukus":1,"start":5967,"verses":[{"surahNumber":88,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ","translation":"Has the news of the overwhelming event reached you?","juz":30,"quranLink":"https://quran.com/88/1"},{"surahNumber":88,"ayahNumber":2,"arabic":"وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ","translation":"Some faces that Day shall be downcast with fear,","juz":30,"quranLink":"https://quran.com/88/2"},{"surahNumber":88,"ayahNumber":3,"arabic":"عَامِلَةٌ نَّاصِبَةٌ","translation":"be toiling and worn-out;","juz":30,"quranLink":"https://quran.com/88/3"},{"surahNumber":88,"ayahNumber":4,"arabic":"تَصْلَىٰ نَارًا حَامِيَةً","translation":"they shall burn in a Scorching Fire;","juz":30,"quranLink":"https://quran.com/88/4"},{"surahNumber":88,"ayahNumber":5,"arabic":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ","translation":"their drink shall be from a boiling spring.","juz":30,"quranLink":"https://quran.com/88/5"},{"surahNumber":88,"ayahNumber":6,"arabic":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ","translation":"They shall have no food except bitter dry thorns","juz":30,"quranLink":"https://quran.com/88/6"},{"surahNumber":88,"ayahNumber":7,"arabic":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ","translation":"that will neither nourish nor satisfy their hunger.","juz":30,"quranLink":"https://quran.com/88/7"},{"surahNumber":88,"ayahNumber":8,"arabic":"وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ","translation":"On that very Day some faces shall be radiant with joy,","juz":30,"quranLink":"https://quran.com/88/8"},{"surahNumber":88,"ayahNumber":9,"arabic":"لِّسَعْيِهَا رَاضِيَةٌ","translation":"well-pleased with their striving.","juz":30,"quranLink":"https://quran.com/88/9"},{"surahNumber":88,"ayahNumber":10,"arabic":"فِى جَنَّةٍ عَالِيَةٍ","translation":"They will be in a lofty Garden","juz":30,"quranLink":"https://quran.com/88/10"},{"surahNumber":88,"ayahNumber":11,"arabic":"لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً","translation":"wherein they shall hear no vain talk.","juz":30,"quranLink":"https://quran.com/88/11"},{"surahNumber":88,"ayahNumber":12,"arabic":"فِيهَا عَيْنٌ جَارِيَةٌ","translation":"In it there shall be a flowing spring,","juz":30,"quranLink":"https://quran.com/88/12"},{"surahNumber":88,"ayahNumber":13,"arabic":"فِيهَا سُرُرٌ مَّرْفُوعَةٌ","translation":"and couches raised high,","juz":30,"quranLink":"https://quran.com/88/13"},{"surahNumber":88,"ayahNumber":14,"arabic":"وَأَكْوَابٌ مَّوْضُوعَةٌ","translation":"and goblets laid out,","juz":30,"quranLink":"https://quran.com/88/14"},{"surahNumber":88,"ayahNumber":15,"arabic":"وَنَمَارِقُ مَصْفُوفَةٌ","translation":"and cushions arrayed in rows,","juz":30,"quranLink":"https://quran.com/88/15"},{"surahNumber":88,"ayahNumber":16,"arabic":"وَزَرَابِىُّ مَبْثُوثَةٌ","translation":"and rich carpets levelled out.","juz":30,"quranLink":"https://quran.com/88/16"},{"surahNumber":88,"ayahNumber":17,"arabic":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","translation":"Do (these unbelievers) not observe the camels: how they were created?","juz":30,"quranLink":"https://quran.com/88/17"},{"surahNumber":88,"ayahNumber":18,"arabic":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","translation":"And the sky: how it was raised high?","juz":30,"quranLink":"https://quran.com/88/18"},{"surahNumber":88,"ayahNumber":19,"arabic":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","translation":"And the mountains: how they were fixed?","juz":30,"quranLink":"https://quran.com/88/19"},{"surahNumber":88,"ayahNumber":20,"arabic":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","translation":"And the earth: how it was spread out?","juz":30,"quranLink":"https://quran.com/88/20"},{"surahNumber":88,"ayahNumber":21,"arabic":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ","translation":"So render good counsel, for you are simply required to counsel,","juz":30,"quranLink":"https://quran.com/88/21"},{"surahNumber":88,"ayahNumber":22,"arabic":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","translation":"and are not invested with the authority to compel them.","juz":30,"quranLink":"https://quran.com/88/22"},{"surahNumber":88,"ayahNumber":23,"arabic":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","translation":"But whoever will turn away (from the Truth),","juz":30,"quranLink":"https://quran.com/88/23"},{"surahNumber":88,"ayahNumber":24,"arabic":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","translation":"Allah will chastise him with the most terrible chastisement.","juz":30,"quranLink":"https://quran.com/88/24"},{"surahNumber":88,"ayahNumber":25,"arabic":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","translation":"Surely to Us is their return;","juz":30,"quranLink":"https://quran.com/88/25"},{"surahNumber":88,"ayahNumber":26,"arabic":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","translation":"and then it is for Us to call them to account.","juz":30,"quranLink":"https://quran.com/88/26"}]}