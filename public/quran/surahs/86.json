{"number":86,"name":"At-Taariq","arabicName":"الطارق","englishTranslation":"The Morning Star","numberOfAyahs":17,"revelationType":"Meccan","order":36,"rukus":1,"start":5931,"verses":[{"surahNumber":86,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","translation":"By the heaven, and the night-visitor,","juz":30,"quranLink":"https://quran.com/86/1"},{"surahNumber":86,"ayahNumber":2,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","translation":"what do you know what the night-visitor is?","juz":30,"quranLink":"https://quran.com/86/2"},{"surahNumber":86,"ayahNumber":3,"arabic":"ٱلنَّجْمُ ٱلثَّاقِبُ","translation":"It is the piercing star.","juz":30,"quranLink":"https://quran.com/86/3"},{"surahNumber":86,"ayahNumber":4,"arabic":"إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ","translation":"There is no living being but there is a protector over it.","juz":30,"quranLink":"https://quran.com/86/4"},{"surahNumber":86,"ayahNumber":5,"arabic":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ","translation":"So let man consider of what he was created.","juz":30,"quranLink":"https://quran.com/86/5"},{"surahNumber":86,"ayahNumber":6,"arabic":"خُلِقَ مِن مَّآءٍ دَافِقٍ","translation":"He was created of a gushing fluid,","juz":30,"quranLink":"https://quran.com/86/6"},{"surahNumber":86,"ayahNumber":7,"arabic":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","translation":"emanating from between the loins and the ribs.","juz":30,"quranLink":"https://quran.com/86/7"},{"surahNumber":86,"ayahNumber":8,"arabic":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ","translation":"Surely He (the Creator) has the power to bring him back (to life).","juz":30,"quranLink":"https://quran.com/86/8"},{"surahNumber":86,"ayahNumber":9,"arabic":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","translation":"On the Day when man's deepest secrets shall be put to the test","juz":30,"quranLink":"https://quran.com/86/9"},{"surahNumber":86,"ayahNumber":10,"arabic":"فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ","translation":"he shall have no power, and no helper.","juz":30,"quranLink":"https://quran.com/86/10"},{"surahNumber":86,"ayahNumber":11,"arabic":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","translation":"By the heaven with its recurring cycle of rain,","juz":30,"quranLink":"https://quran.com/86/11"},{"surahNumber":86,"ayahNumber":12,"arabic":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","translation":"and by the earth ever bursting with verdure,","juz":30,"quranLink":"https://quran.com/86/12"},{"surahNumber":86,"ayahNumber":13,"arabic":"إِنَّهُۥ لَقَوْلٌ فَصْلٌ","translation":"this (Qur'an) is surely a decisive Word,","juz":30,"quranLink":"https://quran.com/86/13"},{"surahNumber":86,"ayahNumber":14,"arabic":"وَمَا هُوَ بِٱلْهَزْلِ","translation":"not a flippant jest.","juz":30,"quranLink":"https://quran.com/86/14"},{"surahNumber":86,"ayahNumber":15,"arabic":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","translation":"They are devising a guile,","juz":30,"quranLink":"https://quran.com/86/15"},{"surahNumber":86,"ayahNumber":16,"arabic":"وَأَكِيدُ كَيْدًا","translation":"and I too am devising a guile.","juz":30,"quranLink":"https://quran.com/86/16"},{"surahNumber":86,"ayahNumber":17,"arabic":"فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","translation":"So leave the unbelievers to themselves; respite them awhile.","juz":30,"quranLink":"https://quran.com/86/17"}]}