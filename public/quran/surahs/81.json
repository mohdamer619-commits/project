{"number":81,"name":"At-Takwir","arabicName":"التكوير","englishTranslation":"The Overthrowing","numberOfAyahs":29,"revelationType":"Meccan","order":7,"rukus":1,"start":5800,"verses":[{"surahNumber":81,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ","translation":"When the sun shall be folded up,","juz":30,"quranLink":"https://quran.com/81/1"},{"surahNumber":81,"ayahNumber":2,"arabic":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","translation":"when the stars shall scatter away,","juz":30,"quranLink":"https://quran.com/81/2"},{"surahNumber":81,"ayahNumber":3,"arabic":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","translation":"when the mountains shall be set in motion,","juz":30,"quranLink":"https://quran.com/81/3"},{"surahNumber":81,"ayahNumber":4,"arabic":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","translation":"when the ten-months pregnant camels shall be abandoned,","juz":30,"quranLink":"https://quran.com/81/4"},{"surahNumber":81,"ayahNumber":5,"arabic":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","translation":"when the savage beasts shall be brought together,","juz":30,"quranLink":"https://quran.com/81/5"},{"surahNumber":81,"ayahNumber":6,"arabic":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","translation":"when the seas shall be set boiling,","juz":30,"quranLink":"https://quran.com/81/6"},{"surahNumber":81,"ayahNumber":7,"arabic":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","translation":"when the souls shall be rejoined (with their bodies),","juz":30,"quranLink":"https://quran.com/81/7"},{"surahNumber":81,"ayahNumber":8,"arabic":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","translation":"and when the girl-child buried alive shall be asked:","juz":30,"quranLink":"https://quran.com/81/8"},{"surahNumber":81,"ayahNumber":9,"arabic":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","translation":"for what offence was she killed?","juz":30,"quranLink":"https://quran.com/81/9"},{"surahNumber":81,"ayahNumber":10,"arabic":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","translation":"and when the scrolls of (men's) deeds shall be unfolded,","juz":30,"quranLink":"https://quran.com/81/10"},{"surahNumber":81,"ayahNumber":11,"arabic":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","translation":"and when Heaven is laid bare;","juz":30,"quranLink":"https://quran.com/81/11"},{"surahNumber":81,"ayahNumber":12,"arabic":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","translation":"and Hell is stoked,","juz":30,"quranLink":"https://quran.com/81/12"},{"surahNumber":81,"ayahNumber":13,"arabic":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","translation":"and Paradise brought nigh:","juz":30,"quranLink":"https://quran.com/81/13"},{"surahNumber":81,"ayahNumber":14,"arabic":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","translation":"then shall each person know what he has brought along.","juz":30,"quranLink":"https://quran.com/81/14"},{"surahNumber":81,"ayahNumber":15,"arabic":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","translation":"No indeed; I swear by the alternating stars","juz":30,"quranLink":"https://quran.com/81/15"},{"surahNumber":81,"ayahNumber":16,"arabic":"ٱلْجَوَارِ ٱلْكُنَّسِ","translation":"that hide,","juz":30,"quranLink":"https://quran.com/81/16"},{"surahNumber":81,"ayahNumber":17,"arabic":"وَٱلَّيْلِ إِذَا عَسْعَسَ","translation":"and by the night as it recedes,","juz":30,"quranLink":"https://quran.com/81/17"},{"surahNumber":81,"ayahNumber":18,"arabic":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","translation":"and the morn as it breathes.","juz":30,"quranLink":"https://quran.com/81/18"},{"surahNumber":81,"ayahNumber":19,"arabic":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","translation":"Verily this is the word of a noble message-bearer;","juz":30,"quranLink":"https://quran.com/81/19"},{"surahNumber":81,"ayahNumber":20,"arabic":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","translation":"one mighty and held in honour with the Lord of the Throne;","juz":30,"quranLink":"https://quran.com/81/20"},{"surahNumber":81,"ayahNumber":21,"arabic":"مُّطَاعٍ ثَمَّ أَمِينٍ","translation":"there he is obeyed and held trustworthy.","juz":30,"quranLink":"https://quran.com/81/21"},{"surahNumber":81,"ayahNumber":22,"arabic":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","translation":"(O people of Makkah), your companion is not mad;","juz":30,"quranLink":"https://quran.com/81/22"},{"surahNumber":81,"ayahNumber":23,"arabic":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","translation":"he indeed saw the message-bearer on the clear horizon;","juz":30,"quranLink":"https://quran.com/81/23"},{"surahNumber":81,"ayahNumber":24,"arabic":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","translation":"nor does he grudge (conveying this knowledge about) the Unseen;","juz":30,"quranLink":"https://quran.com/81/24"},{"surahNumber":81,"ayahNumber":25,"arabic":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","translation":"nor is it a word of an accursed Satan.","juz":30,"quranLink":"https://quran.com/81/25"},{"surahNumber":81,"ayahNumber":26,"arabic":"فَأَيْنَ تَذْهَبُونَ","translation":"Where to are you then heading?","juz":30,"quranLink":"https://quran.com/81/26"},{"surahNumber":81,"ayahNumber":27,"arabic":"إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ","translation":"It is nothing but Good Counsel for everyone in the world,","juz":30,"quranLink":"https://quran.com/81/27"},{"surahNumber":81,"ayahNumber":28,"arabic":"لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ","translation":"for everyone of you who wishes to follow the Straight Way;","juz":30,"quranLink":"https://quran.com/81/28"},{"surahNumber":81,"ayahNumber":29,"arabic":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ","translation":"but your wishing will not avail unless Allah, the Lord of the Universe, so wishes.","juz":30,"quranLink":"https://quran.com/81/29"}]}