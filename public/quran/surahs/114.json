{"number":114,"name":"An-Naas","arabicName":"الناس","englishTranslation":"Mankind","numberOfAyahs":6,"revelationType":"Meccan","order":21,"rukus":1,"start":6230,"verses":[{"surahNumber":114,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"Say: “I seek refuge with the Lord of mankind;","juz":30,"quranLink":"https://quran.com/114/1"},{"surahNumber":114,"ayahNumber":2,"arabic":"مَلِكِ ٱلنَّاسِ","translation":"the King of mankind,","juz":30,"quranLink":"https://quran.com/114/2"},{"surahNumber":114,"ayahNumber":3,"arabic":"إِلَـٰهِ ٱلنَّاسِ","translation":"the True God of mankind,","juz":30,"quranLink":"https://quran.com/114/3"},{"surahNumber":114,"ayahNumber":4,"arabic":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","translation":"from the mischief of the whispering, elusive prompter who returns again and again,","juz":30,"quranLink":"https://quran.com/114/4"},{"surahNumber":114,"ayahNumber":5,"arabic":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","translation":"who whispers in the hearts of people;","juz":30,"quranLink":"https://quran.com/114/5"},{"surahNumber":114,"ayahNumber":6,"arabic":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","translation":"whether he be from the jinn or humans.”","juz":30,"quranLink":"https://quran.com/114/6"}]}