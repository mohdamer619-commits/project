{"number":96,"name":"Al-Alaq","arabicName":"العلق","englishTranslation":"The Clot","numberOfAyahs":19,"revelationType":"Meccan","order":1,"rukus":1,"start":6106,"verses":[{"surahNumber":96,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","translation":"Recite in the name of your Lord Who created,","juz":30,"quranLink":"https://quran.com/96/1"},{"surahNumber":96,"ayahNumber":2,"arabic":"خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ","translation":"created man from a clot of congealed blood.","juz":30,"quranLink":"https://quran.com/96/2"},{"surahNumber":96,"ayahNumber":3,"arabic":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","translation":"Recite: and your Lord is Most Generous,","juz":30,"quranLink":"https://quran.com/96/3"},{"surahNumber":96,"ayahNumber":4,"arabic":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","translation":"Who taught by the pen,","juz":30,"quranLink":"https://quran.com/96/4"},{"surahNumber":96,"ayahNumber":5,"arabic":"عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ","translation":"taught man what he did not know.","juz":30,"quranLink":"https://quran.com/96/5"},{"surahNumber":96,"ayahNumber":6,"arabic":"كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ","translation":"Nay, surely man transgresses;","juz":30,"quranLink":"https://quran.com/96/6"},{"surahNumber":96,"ayahNumber":7,"arabic":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","translation":"for he believes himself to be self-sufficient.","juz":30,"quranLink":"https://quran.com/96/7"},{"surahNumber":96,"ayahNumber":8,"arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","translation":"Surely to your Lord is your return.","juz":30,"quranLink":"https://quran.com/96/8"},{"surahNumber":96,"ayahNumber":9,"arabic":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","translation":"Did you see him who forbids","juz":30,"quranLink":"https://quran.com/96/9"},{"surahNumber":96,"ayahNumber":10,"arabic":"عَبْدًا إِذَا صَلَّىٰٓ","translation":"a servant (of Allah) when he prays?","juz":30,"quranLink":"https://quran.com/96/10"},{"surahNumber":96,"ayahNumber":11,"arabic":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","translation":"Did you consider: what if he is on the Right Way,","juz":30,"quranLink":"https://quran.com/96/11"},{"surahNumber":96,"ayahNumber":12,"arabic":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","translation":"and enjoins piety?","juz":30,"quranLink":"https://quran.com/96/12"},{"surahNumber":96,"ayahNumber":13,"arabic":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","translation":"Did you consider: what if he gives the lie (to the Truth) and turns away (from it)?","juz":30,"quranLink":"https://quran.com/96/13"},{"surahNumber":96,"ayahNumber":14,"arabic":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","translation":"Does he not know that Allah sees everything?","juz":30,"quranLink":"https://quran.com/96/14"},{"surahNumber":96,"ayahNumber":15,"arabic":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","translation":"No indeed; if he does not desist, We shall drag him by the forelock;","juz":30,"quranLink":"https://quran.com/96/15"},{"surahNumber":96,"ayahNumber":16,"arabic":"نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ","translation":"by the lying forelock steeped in sin.","juz":30,"quranLink":"https://quran.com/96/16"},{"surahNumber":96,"ayahNumber":17,"arabic":"فَلْيَدْعُ نَادِيَهُۥ","translation":"So let him summon his helpmates;","juz":30,"quranLink":"https://quran.com/96/17"},{"surahNumber":96,"ayahNumber":18,"arabic":"سَنَدْعُ ٱلزَّبَانِيَةَ","translation":"We too shall summon the guards of Hell.","juz":30,"quranLink":"https://quran.com/96/18"},{"surahNumber":96,"ayahNumber":19,"arabic":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","translation":"No, not at all. Never obey him. But prostrate yourself and become nigh (to your Lord).","juz":30,"quranLink":"https://quran.com/96/19"}]}