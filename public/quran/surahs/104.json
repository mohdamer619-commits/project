{"number":104,"name":"Al-Humaza","arabicName":"الهمزة","englishTranslation":"The Traducer","numberOfAyahs":9,"revelationType":"Meccan","order":32,"rukus":1,"start":6179,"verses":[{"surahNumber":104,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍ","translation":"Woe to every fault-finding backbiter;","juz":30,"quranLink":"https://quran.com/104/1"},{"surahNumber":104,"ayahNumber":2,"arabic":"ٱلَّذِى جَمَعَ مَالًا وَعَدَّدَهُۥ","translation":"who amasses wealth and counts it over and again.","juz":30,"quranLink":"https://quran.com/104/2"},{"surahNumber":104,"ayahNumber":3,"arabic":"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ","translation":"He thinks that his wealth will immortalise him forever.","juz":30,"quranLink":"https://quran.com/104/3"},{"surahNumber":104,"ayahNumber":4,"arabic":"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ","translation":"Nay, he shall be thrown into the Crusher.","juz":30,"quranLink":"https://quran.com/104/4"},{"surahNumber":104,"ayahNumber":5,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ","translation":"And what do you know what the Crusher is?","juz":30,"quranLink":"https://quran.com/104/5"},{"surahNumber":104,"ayahNumber":6,"arabic":"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ","translation":"It is the Fire kindled by Allah,","juz":30,"quranLink":"https://quran.com/104/6"},{"surahNumber":104,"ayahNumber":7,"arabic":"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ","translation":"the Fire that shall rise to the hearts (of criminals).","juz":30,"quranLink":"https://quran.com/104/7"},{"surahNumber":104,"ayahNumber":8,"arabic":"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ","translation":"Verily it will close in upon them,","juz":30,"quranLink":"https://quran.com/104/8"},{"surahNumber":104,"ayahNumber":9,"arabic":"فِى عَمَدٍ مُّمَدَّدَةٍۭ","translation":"in outstretched columns.","juz":30,"quranLink":"https://quran.com/104/9"}]}