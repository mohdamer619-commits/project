{"number":94,"name":"Ash-Sharh","arabicName":"الشرح","englishTranslation":"The Consolation","numberOfAyahs":8,"revelationType":"Meccan","order":12,"rukus":1,"start":6090,"verses":[{"surahNumber":94,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","translation":"(O Prophet), Did We not lay open your breast","juz":30,"quranLink":"https://quran.com/94/1"},{"surahNumber":94,"ayahNumber":2,"arabic":"وَوَضَعْنَا عَنكَ وِزْرَكَ","translation":"and relieve you of the burden","juz":30,"quranLink":"https://quran.com/94/2"},{"surahNumber":94,"ayahNumber":3,"arabic":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","translation":"that had well-nigh broken your back?","juz":30,"quranLink":"https://quran.com/94/3"},{"surahNumber":94,"ayahNumber":4,"arabic":"وَرَفَعْنَا لَكَ ذِكْرَكَ","translation":"And did We not exalt your fame?","juz":30,"quranLink":"https://quran.com/94/4"},{"surahNumber":94,"ayahNumber":5,"arabic":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","translation":"Indeed, there is ease with hardship.","juz":30,"quranLink":"https://quran.com/94/5"},{"surahNumber":94,"ayahNumber":6,"arabic":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","translation":"Most certainly, there is ease with hardship.","juz":30,"quranLink":"https://quran.com/94/6"},{"surahNumber":94,"ayahNumber":7,"arabic":"فَإِذَا فَرَغْتَ فَٱنصَبْ","translation":"So, whenever you are free, strive in devotion,","juz":30,"quranLink":"https://quran.com/94/7"},{"surahNumber":94,"ayahNumber":8,"arabic":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","translation":"and turn to your Lord with longing.","juz":30,"quranLink":"https://quran.com/94/8"}]}