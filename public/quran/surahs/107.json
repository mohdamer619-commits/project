{"number":107,"name":"Al-Maa'un","arabicName":"الماعون","englishTranslation":"Almsgiving","numberOfAyahs":7,"revelationType":"Meccan","order":17,"rukus":1,"start":6197,"verses":[{"surahNumber":107,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","translation":"Did you see him who gives the lie to the Reward and Punishment of the Hereafter?","juz":30,"quranLink":"https://quran.com/107/1"},{"surahNumber":107,"ayahNumber":2,"arabic":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","translation":"Such is the one who repulses the orphans away,","juz":30,"quranLink":"https://quran.com/107/2"},{"surahNumber":107,"ayahNumber":3,"arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","translation":"and urges not the feeding of the needy.","juz":30,"quranLink":"https://quran.com/107/3"},{"surahNumber":107,"ayahNumber":4,"arabic":"فَوَيْلٌ لِّلْمُصَلِّينَ","translation":"Woe, then, to those who pray,","juz":30,"quranLink":"https://quran.com/107/4"},{"surahNumber":107,"ayahNumber":5,"arabic":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","translation":"but are heedless in their Prayers,","juz":30,"quranLink":"https://quran.com/107/5"},{"surahNumber":107,"ayahNumber":6,"arabic":"ٱلَّذِينَ هُمْ يُرَآءُونَ","translation":"those who do good (in order) to be seen,","juz":30,"quranLink":"https://quran.com/107/6"},{"surahNumber":107,"ayahNumber":7,"arabic":"وَيَمْنَعُونَ ٱلْمَاعُونَ","translation":"and deny people the articles of common necessity.","juz":30,"quranLink":"https://quran.com/107/7"}]}