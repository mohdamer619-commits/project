{"number":101,"name":"Al-Qaari'a","arabicName":"القارعة","englishTranslation":"The Calamity","numberOfAyahs":11,"revelationType":"Meccan","order":30,"rukus":1,"start":6157,"verses":[{"surahNumber":101,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ٱلْقَارِعَةُ","translation":"The Calamity!","juz":30,"quranLink":"https://quran.com/101/1"},{"surahNumber":101,"ayahNumber":2,"arabic":"مَا ٱلْقَارِعَةُ","translation":"What is the Calamity?","juz":30,"quranLink":"https://quran.com/101/2"},{"surahNumber":101,"ayahNumber":3,"arabic":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","translation":"And what do you know what the Calamity is?","juz":30,"quranLink":"https://quran.com/101/3"},{"surahNumber":101,"ayahNumber":4,"arabic":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","translation":"On that Day human beings shall be like scattered moths,","juz":30,"quranLink":"https://quran.com/101/4"},{"surahNumber":101,"ayahNumber":5,"arabic":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","translation":"and the mountains shall be like fluffs of carded wool in varying colours.","juz":30,"quranLink":"https://quran.com/101/5"},{"surahNumber":101,"ayahNumber":6,"arabic":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","translation":"Then he whose scales weigh heavier","juz":30,"quranLink":"https://quran.com/101/6"},{"surahNumber":101,"ayahNumber":7,"arabic":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","translation":"shall have a blissful life;","juz":30,"quranLink":"https://quran.com/101/7"},{"surahNumber":101,"ayahNumber":8,"arabic":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","translation":"but he whose scales weigh lighter,","juz":30,"quranLink":"https://quran.com/101/8"},{"surahNumber":101,"ayahNumber":9,"arabic":"فَأُمُّهُۥ هَاوِيَةٌ","translation":"his shall be the deep pit for a dwelling.","juz":30,"quranLink":"https://quran.com/101/9"},{"surahNumber":101,"ayahNumber":10,"arabic":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","translation":"And what do you know what that is?","juz":30,"quranLink":"https://quran.com/101/10"},{"surahNumber":101,"ayahNumber":11,"arabic":"نَارٌ حَامِيَةٌۢ","translation":"A Blazing Fire!","juz":30,"quranLink":"https://quran.com/101/11"}]}