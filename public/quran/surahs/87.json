{"number":87,"name":"Al-A'laa","arabicName":"الأعلى","englishTranslation":"The Most High","numberOfAyahs":19,"revelationType":"Meccan","order":8,"rukus":1,"start":5948,"verses":[{"surahNumber":87,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","translation":"Glorify the name of your Lord, the Most High,","juz":30,"quranLink":"https://quran.com/87/1"},{"surahNumber":87,"ayahNumber":2,"arabic":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","translation":"Who created all things and fashioned them in good proportion;","juz":30,"quranLink":"https://quran.com/87/2"},{"surahNumber":87,"ayahNumber":3,"arabic":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","translation":"Who determined and guided them,","juz":30,"quranLink":"https://quran.com/87/3"},{"surahNumber":87,"ayahNumber":4,"arabic":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","translation":"Who brought forth the pasture,","juz":30,"quranLink":"https://quran.com/87/4"},{"surahNumber":87,"ayahNumber":5,"arabic":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","translation":"and then made it into a blackish straw.","juz":30,"quranLink":"https://quran.com/87/5"},{"surahNumber":87,"ayahNumber":6,"arabic":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","translation":"We shall make you recite and then you will not forget,","juz":30,"quranLink":"https://quran.com/87/6"},{"surahNumber":87,"ayahNumber":7,"arabic":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","translation":"except what Allah should wish. He knows all that is manifest and all that is hidden.","juz":30,"quranLink":"https://quran.com/87/7"},{"surahNumber":87,"ayahNumber":8,"arabic":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","translation":"We shall ease you to follow the way of Ease.","juz":30,"quranLink":"https://quran.com/87/8"},{"surahNumber":87,"ayahNumber":9,"arabic":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","translation":"So render good counsel if good counsel will avail.","juz":30,"quranLink":"https://quran.com/87/9"},{"surahNumber":87,"ayahNumber":10,"arabic":"سَيَذَّكَّرُ مَن يَخْشَىٰ","translation":"He who fears (Allah) shall heed it,","juz":30,"quranLink":"https://quran.com/87/10"},{"surahNumber":87,"ayahNumber":11,"arabic":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","translation":"but the wretched will turn away from it.","juz":30,"quranLink":"https://quran.com/87/11"},{"surahNumber":87,"ayahNumber":12,"arabic":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","translation":"He will be cast into the Great Fire.","juz":30,"quranLink":"https://quran.com/87/12"},{"surahNumber":87,"ayahNumber":13,"arabic":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","translation":"Then he will neither die in it, nor live.","juz":30,"quranLink":"https://quran.com/87/13"},{"surahNumber":87,"ayahNumber":14,"arabic":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","translation":"He who purified himself shall prosper,","juz":30,"quranLink":"https://quran.com/87/14"},{"surahNumber":87,"ayahNumber":15,"arabic":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","translation":"remembering his Lord's name and praying.","juz":30,"quranLink":"https://quran.com/87/15"},{"surahNumber":87,"ayahNumber":16,"arabic":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","translation":"No; but you prefer the present life,","juz":30,"quranLink":"https://quran.com/87/16"},{"surahNumber":87,"ayahNumber":17,"arabic":"وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ","translation":"whereas the Hereafter is better and more enduring.","juz":30,"quranLink":"https://quran.com/87/17"},{"surahNumber":87,"ayahNumber":18,"arabic":"إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","translation":"This, indeed, was in the ancient Scrolls,","juz":30,"quranLink":"https://quran.com/87/18"},{"surahNumber":87,"ayahNumber":19,"arabic":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","translation":"the Scrolls of Abraham and Moses.","juz":30,"quranLink":"https://quran.com/87/19"}]}