{"number":80,"name":"Abasa","arabicName":"عبس","englishTranslation":"He frowned","numberOfAyahs":42,"revelationType":"Meccan","order":24,"rukus":1,"start":5758,"verses":[{"surahNumber":80,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ","translation":"He frowned and turned away","juz":30,"quranLink":"https://quran.com/80/1"},{"surahNumber":80,"ayahNumber":2,"arabic":"أَن جَآءَهُ ٱلْأَعْمَىٰ","translation":"that the blind man came to him.","juz":30,"quranLink":"https://quran.com/80/2"},{"surahNumber":80,"ayahNumber":3,"arabic":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"How could you know? Perhaps he would cleanse himself,","juz":30,"quranLink":"https://quran.com/80/3"},{"surahNumber":80,"ayahNumber":4,"arabic":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ","translation":"or he might be mindful and good counsel might avail him.","juz":30,"quranLink":"https://quran.com/80/4"},{"surahNumber":80,"ayahNumber":5,"arabic":"أَمَّا مَنِ ٱسْتَغْنَىٰ","translation":"Now he who waxes indifferent,","juz":30,"quranLink":"https://quran.com/80/5"},{"surahNumber":80,"ayahNumber":6,"arabic":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"you attend to him,","juz":30,"quranLink":"https://quran.com/80/6"},{"surahNumber":80,"ayahNumber":7,"arabic":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","translation":"though you are not to blame if he would not cleanse himself.","juz":30,"quranLink":"https://quran.com/80/7"},{"surahNumber":80,"ayahNumber":8,"arabic":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ","translation":"But he who comes to you running,","juz":30,"quranLink":"https://quran.com/80/8"},{"surahNumber":80,"ayahNumber":9,"arabic":"وَهُوَ يَخْشَىٰ","translation":"and fears (Allah),","juz":30,"quranLink":"https://quran.com/80/9"},{"surahNumber":80,"ayahNumber":10,"arabic":"فَأَنتَ عَنْهُ تَلَهَّىٰ","translation":"you pay no heed to him.","juz":30,"quranLink":"https://quran.com/80/10"},{"surahNumber":80,"ayahNumber":11,"arabic":"كَلَّآ إِنَّهَا تَذْكِرَةٌ","translation":"No indeed; this is only a Reminder.","juz":30,"quranLink":"https://quran.com/80/11"},{"surahNumber":80,"ayahNumber":12,"arabic":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"So whoso wills may give heed to it.","juz":30,"quranLink":"https://quran.com/80/12"},{"surahNumber":80,"ayahNumber":13,"arabic":"فِى صُحُفٍ مُّكَرَّمَةٍ","translation":"It is contained in scrolls highly honoured,","juz":30,"quranLink":"https://quran.com/80/13"},{"surahNumber":80,"ayahNumber":14,"arabic":"مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ","translation":"most exalted and purified,","juz":30,"quranLink":"https://quran.com/80/14"},{"surahNumber":80,"ayahNumber":15,"arabic":"بِأَيْدِى سَفَرَةٍ","translation":"borne by the hands of scribes,","juz":30,"quranLink":"https://quran.com/80/15"},{"surahNumber":80,"ayahNumber":16,"arabic":"كِرَامٍۭ بَرَرَةٍ","translation":"noble and purified.","juz":30,"quranLink":"https://quran.com/80/16"},{"surahNumber":80,"ayahNumber":17,"arabic":"قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ","translation":"Accursed be man! How stubbornly he denies the Truth.","juz":30,"quranLink":"https://quran.com/80/17"},{"surahNumber":80,"ayahNumber":18,"arabic":"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ","translation":"Out of what did Allah create him?","juz":30,"quranLink":"https://quran.com/80/18"},{"surahNumber":80,"ayahNumber":19,"arabic":"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":"Out of a sperm-drop did He create him and then determined a measure for him,","juz":30,"quranLink":"https://quran.com/80/19"},{"surahNumber":80,"ayahNumber":20,"arabic":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":"and then made the course of life easy for him,","juz":30,"quranLink":"https://quran.com/80/20"},{"surahNumber":80,"ayahNumber":21,"arabic":"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ","translation":"then He caused him to die and brought him to the grave,","juz":30,"quranLink":"https://quran.com/80/21"},{"surahNumber":80,"ayahNumber":22,"arabic":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":"and then, whenever He wishes, He will raise him back to life.","juz":30,"quranLink":"https://quran.com/80/22"},{"surahNumber":80,"ayahNumber":23,"arabic":"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ","translation":"Nay, but man did not fulfil what Allah had enjoined upon him.","juz":30,"quranLink":"https://quran.com/80/23"},{"surahNumber":80,"ayahNumber":24,"arabic":"فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":"So let man just consider his food:","juz":30,"quranLink":"https://quran.com/80/24"},{"surahNumber":80,"ayahNumber":25,"arabic":"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا","translation":"We poured water, pouring it in great abundance,","juz":30,"quranLink":"https://quran.com/80/25"},{"surahNumber":80,"ayahNumber":26,"arabic":"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا","translation":"and cleaved the earth, cleaving it asunder;","juz":30,"quranLink":"https://quran.com/80/26"},{"surahNumber":80,"ayahNumber":27,"arabic":"فَأَنۢبَتْنَا فِيهَا حَبًّا","translation":"then caused the grain to grow out of it,","juz":30,"quranLink":"https://quran.com/80/27"},{"surahNumber":80,"ayahNumber":28,"arabic":"وَعِنَبًا وَقَضْبًا","translation":"together with grapes and vegetables,","juz":30,"quranLink":"https://quran.com/80/28"},{"surahNumber":80,"ayahNumber":29,"arabic":"وَزَيْتُونًا وَنَخْلًا","translation":"and olives and palms,","juz":30,"quranLink":"https://quran.com/80/29"},{"surahNumber":80,"ayahNumber":30,"arabic":"وَحَدَآئِقَ غُلْبًا","translation":"and dense orchards,","juz":30,"quranLink":"https://quran.com/80/30"},{"surahNumber":80,"ayahNumber":31,"arabic":"وَفَـٰكِهَةً وَأَبًّا","translation":"and fruits and pastures –","juz":30,"quranLink":"https://quran.com/80/31"},{"surahNumber":80,"ayahNumber":32,"arabic":"مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ","translation":"all this as a provision for you and your cattle.","juz":30,"quranLink":"https://quran.com/80/32"},{"surahNumber":80,"ayahNumber":33,"arabic":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":"But when the deafening cry shall be sounded","juz":30,"quranLink":"https://quran.com/80/33"},{"surahNumber":80,"ayahNumber":34,"arabic":"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ","translation":"on the Day when each man shall flee from his brother,","juz":30,"quranLink":"https://quran.com/80/34"},{"surahNumber":80,"ayahNumber":35,"arabic":"وَأُمِّهِۦ وَأَبِيهِ","translation":"and his mother and his father;","juz":30,"quranLink":"https://quran.com/80/35"},{"surahNumber":80,"ayahNumber":36,"arabic":"وَصَـٰحِبَتِهِۦ وَبَنِيهِ","translation":"and his consort and his children;","juz":30,"quranLink":"https://quran.com/80/36"},{"surahNumber":80,"ayahNumber":37,"arabic":"لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","translation":"on that Day each will be occupied with his own business, making him oblivious of all save himself.","juz":30,"quranLink":"https://quran.com/80/37"},{"surahNumber":80,"ayahNumber":38,"arabic":"وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ","translation":"Some faces on that Day shall be beaming with happiness,","juz":30,"quranLink":"https://quran.com/80/38"},{"surahNumber":80,"ayahNumber":39,"arabic":"ضَاحِكَةٌ مُّسْتَبْشِرَةٌ","translation":"and be cheerful and joyous.","juz":30,"quranLink":"https://quran.com/80/39"},{"surahNumber":80,"ayahNumber":40,"arabic":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","translation":"Some faces on that Day shall be dust-ridden,","juz":30,"quranLink":"https://quran.com/80/40"},{"surahNumber":80,"ayahNumber":41,"arabic":"تَرْهَقُهَا قَتَرَةٌ","translation":"enveloped by darkness.","juz":30,"quranLink":"https://quran.com/80/41"},{"surahNumber":80,"ayahNumber":42,"arabic":"أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ","translation":"These will be the unbelievers, the wicked.","juz":30,"quranLink":"https://quran.com/80/42"}]}