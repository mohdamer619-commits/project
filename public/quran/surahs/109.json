{"number":109,"name":"Al-Kaafiroon","arabicName":"الكافرون","englishTranslation":"The Disbelievers","numberOfAyahs":6,"revelationType":"Meccan","order":18,"rukus":1,"start":6207,"verses":[{"surahNumber":109,"ayahNumber":1,"arabic":"بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","translation":"Say: “O unbelievers!”","juz":30,"quranLink":"https://quran.com/109/1"},{"surahNumber":109,"ayahNumber":2,"arabic":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","translation":"I do not worship those that you worship","juz":30,"quranLink":"https://quran.com/109/2"},{"surahNumber":109,"ayahNumber":3,"arabic":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","translation":"neither do you worship Him Whom I worship;","juz":30,"quranLink":"https://quran.com/109/3"},{"surahNumber":109,"ayahNumber":4,"arabic":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","translation":"nor will I worship those whom you have worshipped;","juz":30,"quranLink":"https://quran.com/109/4"},{"surahNumber":109,"ayahNumber":5,"arabic":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","translation":"nor are you going to worship Him Whom I worship.","juz":30,"quranLink":"https://quran.com/109/5"},{"surahNumber":109,"ayahNumber":6,"arabic":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","translation":"To you is your religion, and to me, my religion.","juz":30,"quranLink":"https://quran.com/109/6"}]}